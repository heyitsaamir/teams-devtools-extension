{
  "name": "teams-devtools-extension",
  "version": "0.1.0",
  "description": "Chrome DevTools extension for inspecting Microsoft Teams bot traffic.",
  "private": false,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/heyitsaamir/teams-devtools-extension.git"
  },
  "bugs": {
    "url": "https://github.com/heyitsaamir/teams-devtools-extension/issues"
  },
  "homepage": "https://github.com/heyitsaamir/teams-devtools-extension#readme",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -b && vite build",
    "clean": "rm -rf dist node_modules/.tmp",
    "zip": "npm run build && cd dist && zip -r ../teams-devtools-extension.zip . -x '**/.DS_Store' -x '.DS_Store'"
  },
  "keywords": [
    "microsoft-teams",
    "devtools",
    "chrome-extension",
    "teams-bot"
  ],
  "dependencies": {
    "date-fns": "^4.1.0",
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.4.1"
  }
}
